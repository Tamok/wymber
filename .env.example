# Copy this file to .env and fill in values. .env is gitignored.

# Strong, unique secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# 'production' enables secret enforcement and requires AUTO_CREATE_TEST_USER=false.
# Leave unset (or 'development') for local development.
APP_ENV=production

# Auto-create the demo TestUser account. MUST be false in production.
AUTO_CREATE_TEST_USER=false

# Optional
# JWT_EXPIRES_HOURS=24
# DEBUG=false
