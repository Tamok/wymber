#!/bin/sh
# Wymber pre-commit: keep the frontend units green AND the service-worker cache version in sync
# with the shell, so returning users never get stale assets and no one has to remember to bump it.
# Intentional bypass: git commit --no-verify
if git diff --cached --name-only | grep -qE '^frontend/'; then
  echo "[pre-commit] frontend changed, running vitest..."
  if ! npx vitest run >/dev/null 2>&1; then
    echo "[pre-commit] FAIL: vitest is red. Fix it, or use --no-verify if you mean to."
    exit 1
  fi
  echo "[pre-commit] vitest green."

  # Derive sw.js VERSION from a content hash of the cached shell, then fold it into this commit.
  node scripts/sw-version.mjs
  git add frontend/sw.js
fi
exit 0
