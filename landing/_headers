# ADR-0003 Layer 1, the landing origin (wymber.app).
#
# script-src allows exactly one inline hash and nothing else: no 'unsafe-inline', no host source,
# no external script may load at all. That single hash is index.html's carousel-arrow script, and
# it is GENERATED by scripts/landing-csp.mjs rather than typed, because the landing has no build
# step and a hand-copied hash silently rots. A drift test fails if the two disagree.
#
# The landing loads zero external resources (no CDN, no fonts, no iframes, no forms), which is why
# connect-src is 'none'. Adding a second inline script, or any external one, means regenerating
# this header first: an unhashed inline script does not error visibly, it just never runs.
#
# Integrity-Policy is ENFORCED here (not report-only): safe, because the only script is inline and
# hash-pinned, so there is no external script fetch to block. The app origin (dist/_headers,
# written by scripts/build-pages.mjs) ships
# the same directive report-only until mindmap.js's Cytoscape <script> element carries an
# `integrity` attribute (see frontend/js/build-info.js's integrityFor helper).
#
# Comments live on their own unindented lines, above the rule: Cloudflare Pages treats a line as
# a comment only when it starts with #, so an indented # inside a block risks being parsed as a
# malformed header rather than ignored.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'sha256-efO2yZ/bFKPYMKJbVnMck84+6f+Vbdvv5/pHGtCjm/Y='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'
  Integrity-Policy: blocked-destinations=(script)
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Cloudflare Pages has no MIME mapping for .jsonl, so without this the transparency log
# (ADR-0007) downloads as application/octet-stream instead of displaying. Verification is
# unaffected either way, but a person clicking the link from /verify should be able to read
# it in the browser, which is the entire point of publishing it.
/integrity-log.jsonl
  Content-Type: text/plain; charset=utf-8
