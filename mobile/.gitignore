# Dependencies
/node_modules/

# Staged web root (generated from ../frontend by scripts/prepare-web.mjs)
/www/

# Native projects: android/ is COMMITTED (it carries the signing config in app/build.gradle;
# its own .gitignore excludes build outputs, local.properties, and the copied web assets).
# ios/ stays ignored until generated + customized, then commit it the same way.
/ios/

# Build + tooling output
/dist/
*.log
.gradle/
.DS_Store
